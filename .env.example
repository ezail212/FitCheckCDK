# Copy to .env and fill in for your machine. Loaded by dotenv in bin/fit_check_cdk.ts.
# Absolute path to the backend Lambda source (the dir that gets zipped & deployed).
LAMBDA_PATH=/absolute/path/to/FitCheck/FitCheckBackend/src
# Absolute path to the built frontend (used later by FrontendStack).
FRONTEND_PATH=/absolute/path/to/FitCheck/FitCheckAssets/dist
# AWS target. Region is required; account/profile taken from your CLI creds if omitted.
CDK_DEFAULT_REGION=us-west-2
# CDK_DEFAULT_ACCOUNT=123456789012
# AWS_PROFILE=your-profile
